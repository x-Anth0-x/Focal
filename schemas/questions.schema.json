{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://x-anth0-x.github.io/Focal/schemas/questions.schema.json",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "skillId": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 3,
            "uniqueItems": true
          },
          "correct": {
            "type": "integer",
            "minimum": 0
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "visual": {
            "enum": [null, "aperture", "motion", "camera", "histogram"]
          }
        },
        "required": [
          "id",
          "skillId",
          "prompt",
          "options",
          "correct",
          "explanation",
          "type"
        ]
      },
      "minItems": 1
    },
    "estimatedMinutes": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 2,
      "maxItems": 2
    },
    "instructions": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": ["version", "questions"]
}
